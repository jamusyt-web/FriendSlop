{
  "name": "friendslop",
  "version": "0.1.0",
  "description": "Chaotic 3D multiplayer hot-potato tag",
  "author": "FriendSlop",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "build:desktop": "node electron/build-client.js",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:linux": "npm run build:desktop && electron-builder --linux"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.friendslop.game",
    "productName": "FriendSlop",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.js",
      "dist-desktop/**/*",
      "!node_modules"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "friendslop"
    }
  }
}
